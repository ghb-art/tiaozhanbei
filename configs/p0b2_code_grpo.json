{
  "config_version": "1.0",
  "protocol": "P0-B2-CODE-GRPO-EXECUTION-REWARD",
  "seed": 20260805,
  "policy": {
    "student_base": "models/checkpoints/p0a4/student-shared-merged",
    "single_shared_lora": true,
    "runtime_adapters": false,
    "formal_feedback_for_training": "none",
    "formal_item_outputs_used": false,
    "humaneval_used": false,
    "pre_registered_candidate_count": 1
  },
  "artifacts": {
    "train_data": "data/p0b2/code_grpo_train.jsonl",
    "validation_data": "data/p0b2/code_grpo_validation.jsonl",
    "holdout_data": "data/p0b2/code_grpo_holdout.jsonl",
    "data_audit": "reports/audit/gate_p0b2_code_data.json",
    "output_dir": "models/checkpoints/p0b2/code-grpo",
    "best_adapter": "models/checkpoints/p0b2/code-grpo/best",
    "train_audit": "reports/audit/gate_p0b2_code_train.json"
  },
  "data": {
    "source": "data/p0b1/code_train.jsonl",
    "train_rows": 16000,
    "validation_rows": 1000,
    "holdout_rows": 3000,
    "output_contract": "humaneval_v15_body_only",
    "unit_test_timeout_sec": 5,
    "forbidden_formal": ["humaneval"]
  },
  "lora": {
    "rank": 16,
    "alpha": 32,
    "dropout": 0.05,
    "target_modules": ["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"]
