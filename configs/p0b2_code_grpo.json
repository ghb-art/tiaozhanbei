    "top_p": 0.95,
    "max_new_tokens": 256,
    "kl_beta": 0.05,
    "kl_reference": "base_adapter_disabled",
    "advantage": "group_normalized",
    "reward": "unit_test_all_pass"
  },
  "optimizer": {
    "learning_rate": 3e-6,
    "weight_decay": 0.05,
    "warmup_ratio": 0.05,
    "scheduler": "cosine",
    "max_grad_norm": 1.0,
    "per_device_train_batch_prompts": 16,
    "gradient_accumulation_steps": 1,
    "epochs": 2,
    "checkpoint_steps": 20,
    "eval_steps": 20
  },
  "selection": {
    "validation_metric": "greedy_execution_pass_rate",
    "minimum_gain_over_base": 0.02,
    "maximum_generation_errors": 0
  },
  "gates": {
    "gate300": {
      "protocol": "p0a5-gate300-v3",
      "initial_ratio": 0.78,
      "recommended_full_ratio": 0.82,
      "code_baseline": "data/eval/p0a5_baseline14b_gate300_v3.jsonl"
    },
    "formal_full": {
      "datasets": {"gsm8k": 1319, "humaneval": 164, "cmmlu": 11582},
      "minimum_ratio_each": 0.8,
      "minimum_capped_macro": 0.8,
      "feedback_after_run": "aggregate_domain_metrics_only"
    }
  }
}
