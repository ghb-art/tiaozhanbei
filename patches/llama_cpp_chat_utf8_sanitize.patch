+static std::string common_chat_sanitize_utf8(const std::string & input, bool is_partial) {
+    std::string output;
+    output.reserve(input.size());
+    size_t offset = 0;
+    while (offset < input.size()) {
+        const auto parsed = common_parse_utf8_codepoint(input, offset);
+        if (parsed.status == utf8_parse_result::SUCCESS) {
+            output.append(input, offset, parsed.bytes_consumed);
+            offset += parsed.bytes_consumed;
+            continue;
+        }
+        if (parsed.status == utf8_parse_result::INCOMPLETE && is_partial) {
+            break;
+        }
+        output.append("\xEF\xBF\xBD");
+        if (parsed.status == utf8_parse_result::INCOMPLETE) {
+            break;
+        }
+        ++offset;
+    }
+    return output;
+}
